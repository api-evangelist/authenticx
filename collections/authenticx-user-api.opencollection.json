{
  "opencollection": "1.0.0",
  "info": {
    "name": "AcxApi Production User API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.beauthenticx.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User By UserName",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beauthenticx.com/User",
            "params": [
              {
                "name": "UserName",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the user with the username specified in the query string."
        },
        {
          "info": {
            "name": "Create User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.beauthenticx.com/User",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a user to your organization."
        },
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beauthenticx.com/User/:UserId",
            "params": [
              {
                "name": "UserId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the user with the id specified in the url."
        },
        {
          "info": {
            "name": "Update User",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.beauthenticx.com/User/:UserId",
            "params": [
              {
                "name": "UserId",
                "value": "",
                "type": "path",
                "description": "The string ID of the user to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates information about an existing user in your organization."
        },
        {
          "info": {
            "name": "Get All Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beauthenticx.com/User/All",
            "params": [
              {
                "name": "IsActive",
                "value": "",
                "type": "query",
                "description": "Filter by active (true) or disabled (false) users. Omit to return all"
              }
            ]
          },
          "docs": "Returns a list of all users in your organization."
        }
      ]
    }
  ],
  "bundled": true
}