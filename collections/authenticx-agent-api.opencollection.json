{
  "opencollection": "1.0.0",
  "info": {
    "name": "AcxApi Production Agent API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.beauthenticx.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Agent",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.beauthenticx.com/Agent",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds an agent to your organization."
        },
        {
          "info": {
            "name": "Get Agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beauthenticx.com/Agent/:AgentId",
            "params": [
              {
                "name": "AgentId",
                "value": "",
                "type": "path",
                "description": "UUID of the agent to retrieve"
              }
            ]
          },
          "docs": "Returns the agent with the id specified in the url."
        },
        {
          "info": {
            "name": "Update Agent",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.beauthenticx.com/Agent/:AgentId",
            "params": [
              {
                "name": "AgentId",
                "value": "",
                "type": "path",
                "description": "UUID of the agent to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates information about an existing agent in your organization."
        },
        {
          "info": {
            "name": "Get All Agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beauthenticx.com/Agent/All",
            "params": [
              {
                "name": "IsActive",
                "value": "",
                "type": "query",
                "description": "Filter by active (true) or inactive (false) agents. Omit to return all"
              }
            ]
          },
          "docs": "Returns a list of all agents in your organization."
        }
      ]
    }
  ],
  "bundled": true
}