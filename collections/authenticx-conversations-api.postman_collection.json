        {
          "id": "df86af3d-3619-4253-be09-0a4452f96755",
          "name": "Get classifier results for conversations based on filter criteria",
          "request": {
            "name": "Get classifier results for conversations based on filter criteria",
            "description": {
              "content": "Returns a list of classifier results for conversations \nwith Status of \"Sampled\" or \"ReadyToSample\" that match the specified criteria.\n            \nRequests without any classifier or hierarchy filters may span up to 7 days.\nSupplying at least one of ClassifierIds, HierarchyIds, HierarchyCodes,\nClassifierCategoryNames, or ClassifierTypes extends the maximum date range to 31 days.\n            \nUse GET /Conversations/Classifiers to discover valid classifier IDs.\nUse GET /Hierarchy/All to discover valid hierarchy IDs and hierarchy codes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Conversations",
                "Insights"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "DateReference",
                  "value": "<string>",
                  "description": "Which date to filter on. Valid values: ArrivalDate (default), InteractionDate."
                },
                {
                  "disabled": false,
                  "key": "StartDate",
                  "value": "<string>",
                  "description": "(Required) ISO 8601 datetime. Required. Requests may span at most 7 days unless at least one of\nClassifierIds, HierarchyIds, HierarchyCodes, ClassifierCategoryNames, or ClassifierTypes\nis supplied, in which case up to 31 days is allowed."
                },
                {
                  "disabled": false,
                  "key": "EndDate",
                  "value": "<string>",
                  "description": "(Required) ISO 8601 datetime. Must be equal to or later than StartDate. Required. The total requested\nrange may be at most 7 days unless at least one of ClassifierIds, HierarchyIds,\nHierarchyCodes, ClassifierCategoryNames, or ClassifierTypes is supplied, in which case up\nto 31 days is allowed."
                },
                {
                  "disabled": false,
                  "key": "ClassifierIds",
                  "value": "<string>",
                  "description": "Comma-separated list of classifier GUIDs. Use GET /Conversations/Classifiers to discover available IDs.\nProviding this filter qualifies the request for the 31-day maximum date range."
                },
                {
                  "disabled": false,
                  "key": "HierarchyIds",
                  "value": "<string>",
                  "description": "Comma-separated list of hierarchy GUIDs. Providing this filter qualifies the request for the\n31-day maximum date range."
                },
                {
                  "disabled": false,
                  "key": "HierarchyCodes",
                  "value": "<string>",
                  "description": "Comma-separated list of hierarchy codes. Resolved to hierarchy IDs automatically. Providing\nthis filter qualifies the request for the 31-day maximum date range."
                },
                {
                  "disabled": false,
                  "key": "ClassifierCategoryNames",
                  "value": "<string>",
                  "description": "Comma-separated category name filter. Valid values: Skills, Topics, Process, SE Suite.\nProviding this filter qualifies the request for the 31-day maximum date range."
                },
                {
                  "disabled": false,
                  "key": "ClassifierTypes",
                  "value": "<string>",
                  "description": "Comma-delimited classifier type filter. Valid values: Classifier, Core AI Model, LLM Model, Metadata.\nProviding this filter qualifies the request for the 31-day maximum date range."
                },
                {
                  "disabled": false,
                  "key": "LastId",
                  "value": "<string>",
                  "description": "GUID of the last conversation from the previous page. Used for cursor-based pagination."
                },
                {
                  "disabled": false,
                  "key": "PageSize",
                  "value": "<integer>",
                  "description": "Results per page. Default 100, max 1000."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
