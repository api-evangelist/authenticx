{
  "opencollection": "1.0.0",
  "info": {
    "name": "AcxApi Production Text Media API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.beauthenticx.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "TextMedia",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload Text Media",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.beauthenticx.com/TextMedia/Upload",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "metadata",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a text media interaction into storage for processing.\n            \n*Param name \"file\"* \n\nText file uploaded from client. \n\nValid File Extensions:\n- .json\n- .json_chat \n\n*Param name \"metadata\"* \n\nJSON object containing multiple metadata fields for the text media File: \n\n            \n> 📘 **Note:** Including the ```Id``` field is recommended. If omitted, one is generated for you, but providing your own lets you correlate with your system.\n            \n- Id:\nUnique identifier for the text m"
        }
      ]
    }
  ],
  "bundled": true
}