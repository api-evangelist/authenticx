{
  "opencollection": "1.0.0",
  "info": {
    "name": "AcxApi Production Roles API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.beauthenticx.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.beauthenticx.com/Roles/All",
            "params": [
              {
                "name": "IsActive",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of all roles in your organization along with their permissions and each permission's description."
        }
      ]
    }
  ],
  "bundled": true
}